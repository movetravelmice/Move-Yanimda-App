rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Zararlı çalıştırılabilir dosya ve script yüklemelerini (HTML/JS/EXE/SH/PHP) engelle
    // ve maksimum dosya boyutunu 25 MB ile sınırla
    function isSafeUpload() {
      return request.resource == null || (
        request.resource.size < 25 * 1024 * 1024
        && !request.resource.contentType.matches('text/html.*')
        && !request.resource.contentType.matches('application/javascript.*')
        && !request.resource.contentType.matches('text/javascript.*')
        && !request.resource.contentType.matches('application/x-msdownload.*')
        && !request.resource.contentType.matches('application/x-executable.*')
        && !request.resource.contentType.matches('application/x-sh.*')
        && !request.resource.contentType.matches('application/x-httpd-php.*')
      );
    }

    // 1. GENEL KÖK VE DİZİN LİSTELEME (ENUMERATION) KESİNLİKLE YASAK!
    // /o veya /o?prefix=... çağrıları anında 403 Forbidden ile engellenir.
    // Hiç kimse depodaki bilet, dosya ve yolcu listesini çekemez.
    match /{allPaths=**} {
      allow list: if false;
    }

    // 2. EXCEL İÇE AKTARIM DOSYALARI (Tüm yolcuların kimlik, pasaport, şifre ve telefonları):
    // Dışarıdan doğrudan GET veya LIST yapılması %100 YASAK!
    match /tours/{tourId}/excel_imports/{allPaths=**} {
      allow read: if false;
      allow list: if false;
      allow write: if isSafeUpload();
    }

    // 3. BİLETLER (TICKETS):
    // Listeleme KESİNLİKLE YASAK! (allow list: if false)
    // Sadece tekil indirme (get) ve güvenli yükleme (write) yapılabilir.
    match /tours/{tourId}/tickets/{allPaths=**} {
      allow list: if false;
      allow get: if true;
      allow write: if isSafeUpload();
    }

    // 4. Genel kapak fotoğrafları:
    match /tour_covers/{allPaths=**} {
      allow list: if false;
      allow get: if true;
      allow write: if isSafeUpload();
    }

    // 5. Chat medyaları:
    match /chat_uploads/{allPaths=**} {
      allow list: if false;
      allow get: if true;
      allow write: if isSafeUpload();
    }

    // 6. Tur programı ekleri:
    match /tour_attachments/{allPaths=**} {
      allow list: if false;
      allow get: if true;
      allow write: if isSafeUpload();
    }
  }
}
